# Used only by the server-side /api/translate Vercel Function.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# Server-only secret used to sign Dexter login sessions. Generate at least 32
# random characters (for example: `openssl rand -base64 48`).
AUTH_SECRET=

# Stripe-hosted recurring billing. The secret key never belongs in browser code.
# Register /api/billing/webhook in Stripe and copy that endpoint's whsec_ value.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Use localhost for local development. In Vercel, set this to the public
# Google Cloud Run service URL, without a trailing slash.
WLASL_API_URL=http://127.0.0.1:8001

# Server-only private storage used by Dexter accounts and the optional WLASL
# backend. Keep this token in Vercel/Cloud Run environment variables only.
BLOB_READ_WRITE_TOKEN=
WLASL_RUNTIME_ROOT=/tmp/dexter-wlasl
WLASL_MAX_CONCURRENT_INFERENCES=1
WLASL_INFERENCE_QUEUE_TIMEOUT_SECONDS=30
DEXTER_ALLOWED_ORIGINS=http://localhost:8000
